{
  "sandbox": true,
  "commands": {
    "allow": [
      {
        "program": "pytest"
      },
      {
        "program": "unittest"
      },
      {
        "program": "git",
        "subcommands": [
          "status",
          "diff"
        ]
      }
    ],
    "deny": [
      {
        "program": "docker"
      }
    ]
  },
  "network": {
    "allow_domains": [
      "docs.python.org",
      "pypi.org",
      "*.readthedocs.io"
    ],
    "search": false
  }
}
